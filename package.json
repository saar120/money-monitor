{
  "name": "money-monitor",
  "version": "0.6.0",
  "description": "",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dashboard:dev\"",
    "build": "shx rm -rf dist && tsc && shx cp -r src/db/migrations dist/db/migrations && npm run dashboard:build",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "dashboard:dev": "cd dashboard && npm run dev",
    "dashboard:build": "cd dashboard && npm run build",
    "mcp": "tsx src/mcp-server.ts",
    "electron:prebuild": "npm run build && tsc -p electron/tsconfig.json && npm run electron:rebuild",
    "electron:dev": "npm run electron:prebuild && electron .",
    "electron:build": "npm run electron:prebuild && electron-builder --mac",
    "electron:build:win": "npm run electron:prebuild && electron-builder --win",
    "electron:build:linux": "npm run electron:prebuild && electron-builder --linux",
    "electron:build:all": "npm run electron:prebuild && electron-builder --mac --win --linux",
    "electron:rebuild": "node scripts/electron-rebuild.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mobile:bootstrap-schema:generate": "node --import tsx scripts/mobile-bootstrap-schema.ts --write",
    "mobile:bootstrap-schema:check": "node --import tsx scripts/mobile-bootstrap-schema.ts --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "postinstall": "patch-package",
    "typecheck": "tsc --emitDeclarationOnly && tsc --noEmit -p electron/tsconfig.json && npm exec --workspace dashboard -- vue-tsc -b --noEmit",
    "test:electron": "vitest run --config electron/mobile-access/vitest.config.ts",
    "check": "npm run lint && npm run check:docs && npm run typecheck && npm run mobile:bootstrap-schema:check && npm test && npm run test:electron",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:36222/git/saar120/money-monitor"
  },
  "workspaces": [
    "dashboard"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.money-monitor.app",
    "productName": "Money Monitor",
    "icon": "electron/icons/icon",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "zip",
      "icon": "electron/icons/icon.icns",
      "category": "public.app-category.finance",
      "artifactName": "Money-Monitor-${version}-${arch}-mac.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/icons/icon.ico",
      "artifactName": "Money-Monitor-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/icons/icon-256.png"
    },
    "files": [
      "dist/**/*.js",
      "dist/db/migrations/**/*",
      "dashboard/dist/**/*",
      "electron/**/*.js",
      "electron/**/*.mjs",
      "electron/icons/**/*"
    ],
    "extraResources": [
      {
        "from": "scripts/money-monitor-mcp",
        "to": "money-monitor-mcp"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/puppeteer-core/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "saar120",
      "repo": "money-monitor"
    }
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@modelcontextprotocol/server": "^2.0.0",
    "@puppeteer/browsers": "^3.2.3",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.5.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "electron-updater": "^6.8.9",
    "fastify": "^5.7.4",
    "grammy": "^1.41.1",
    "israeli-bank-scrapers-core": "6.12.1",
    "node-cron": "^4.2.1",
    "patch-package": "^8.0.1",
    "pino-pretty": "^13.1.3",
    "puppeteer-core": "25.12.0",
    "tar": "^7.5.11",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.0",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.9",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "sharp": "^0.35.4",
    "shx": "^0.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.4.0"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "overrides": {
    "puppeteer-core": "$puppeteer-core"
  }
}
