{
  "expo": {
    "name": "Money Monitor",
    "slug": "money-monitor",
    "version": "1.0.0",
    "scheme": "moneymonitor",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.saaramrani.moneymonitor.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Money Monitor to use Face ID to protect your financial information."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Money Monitor to protect pairing credentials with Face ID."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Money Monitor to scan the pairing code shown on your Mac.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "backgroundColor": "#F5F3EE",
          "dark": {
            "backgroundColor": "#111310"
          }
        }
      ],
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
