{
  "expo": {
    "name": "Money Monitor",
    "slug": "money-monitor",
    "version": "1.0.0",
    "scheme": "moneymonitor",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "locales": {
      "en": {
        "ios": {
          "CFBundleDisplayName": "Money Monitor",
          "NSCameraUsageDescription": "Allow Money Monitor to scan the pairing code shown on your Mac.",
          "NSFaceIDUsageDescription": "Allow Money Monitor to protect your financial information with Face ID."
        }
      },
      "he": {
        "ios": {
          "CFBundleDisplayName": "Money Monitor",
          "NSCameraUsageDescription": "אפשרו ל-Money Monitor לסרוק את קוד הצימוד שמוצג ב-Mac.",
          "NSFaceIDUsageDescription": "אפשרו ל-Money Monitor להגן על המידע הכספי שלכם באמצעות Face ID."
        }
      }
    },
    "ios": {
      "infoPlist": {
        "CFBundleLocalizations": ["en", "he"],
        "CFBundleDevelopmentRegion": "en",
        "CFBundleAllowMixedLocalizations": true
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png"
      },
      "supportsTablet": false,
      "bundleIdentifier": "com.saaramrani.moneymonitor.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      ["expo-localization", { "supportedLocales": { "ios": ["en", "he"] } }],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Money Monitor to use Face ID to protect your financial information."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Money Monitor to protect pairing credentials with Face ID."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Money Monitor to scan the pairing code shown on your Mac.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "backgroundColor": "#F8F7F3",
          "dark": {
            "image": "./assets/icon-dark.png",
            "backgroundColor": "#17212E"
          }
        }
      ],
      "expo-status-bar",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
